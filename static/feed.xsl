<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:atom="http://www.w3.org/2005/Atom" exclude-result-prefixes="atom">
<xsl:output method="html" encoding="UTF-8"/>
<xsl:template match="/"><html lang="en"><head><meta name="viewport" content="width=device-width, initial-scale=1"/><title>L0C0 RSS Feed</title><style>
:root{color-scheme:light dark}body{margin:0;background:#fff;color:#20252d;font:16px/1.8 system-ui,sans-serif}main{max-width:800px;margin:auto;padding:60px 24px}a{color:#456719}h1{line-height:1.3;letter-spacing:-1px}p{color:#616b78}.feed-url{display:block;overflow-wrap:anywhere;padding:16px;border:1px solid #dce1e6;border-radius:6px;font:13px/1.8 monospace}.item{padding:24px 0;border-top:1px solid #dce1e6}.item h2{font-size:22px;margin:0}.item p{font-size:14px}time{font-size:12px;color:#616b78}.empty{margin-top:40px;padding:24px;border:1px solid #dce1e6;border-radius:6px}@media(prefers-color-scheme:dark){body{background:#141619;color:#e9eaed}a{color:#d6f36b}p,time{color:#9ba2ad}.feed-url,.item,.empty{border-color:#2b3038}}
</style></head><body><main><a href="/">← Back to L0C0</a><h1>L0C0 Research / RSS</h1><p>This is our RSS feed. Add the URL below to your feed reader to receive new research posts.</p><code class="feed-url"><xsl:value-of select="rss/channel/atom:link/@href"/></code><xsl:choose><xsl:when test="rss/channel/item"><xsl:for-each select="rss/channel/item"><article class="item"><time><xsl:value-of select="pubDate"/></time><h2><a href="{link}"><xsl:value-of select="title"/></a></h2><p><xsl:value-of select="description"/></p></article></xsl:for-each></xsl:when><xsl:otherwise><div class="empty"><h2>No posts published yet.</h2><p>The feed is ready. New posts will appear here when they are published.</p></div></xsl:otherwise></xsl:choose></main></body></html></xsl:template></xsl:stylesheet>
